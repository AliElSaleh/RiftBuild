# Build-time environment assertions. All of these hold on any Windows x64
# machine with a working shell, so the build must succeed. (Unknown Assert.*
# names are a hard error, so only real ones can be used here:
# Assert.Platform, Assert.Arch, Assert.EnvVarExists, Assert.Program.)
Assembly    AssertsTest
SourceFiles main

Assert.Platform     windows
Assert.Arch         x64
Assert.EnvVarExists OS
Assert.Program      cmd
