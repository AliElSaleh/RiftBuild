# Condition suffixes: platform (windows/!windows) and architecture (x64/!x64).
# The source has #error traps for every wrong combination.
Assembly    Conditional
SourceFiles main

Compiler.Defines:windows  PLAT_WINDOWS=1
Compiler.Defines:!windows PLAT_OTHER=1
Compiler.Defines:x64      ARCH_X64=1
Compiler.Defines:!x64     ARCH_OTHER=1
