Assembly FilterLib
Type     static_lib

Compiler.Includes.Export .

option.variant Turn on the variant build of this library.

# The define carries whatever the option resolved to (0 or 1). The plain key
# applies to this library's own sources; the .Export key is export-only and
# tells consumers which flavor of the library they got.
Compiler.Defines        LIB_VARIANT=%variant
Compiler.Defines.Export LIB_VARIANT=%variant

SourceFiles flib
