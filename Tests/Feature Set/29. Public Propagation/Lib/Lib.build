Assembly PropLib
Type     static_lib

# Export keys are EXPORT-ONLY: they reach whoever depends on this library but
# are NOT applied to the library's own compilation...
Includes.Export .

# Deliberately uses the deprecated ".Public" alias (must behave exactly like
# .Export and emit a deprecation warning) so the alias stays covered.
Defines.Public  LIB_PUBLIC_DEFINE=1

# ...and a static library's Libraries.Export must reach the consumer's LINK:
# the app calls timeGetTime() from winmm, which is not linked by default, so
# dropping this line breaks the app's link (regression guard for the receipt
# export union of Libraries + Libraries.Export).
Libraries.Export:windows winmm

# ...while plain (private) defines apply here and stay inside this module.
Defines LIB_PRIVATE_DEFINE=1

SourceFiles lib
