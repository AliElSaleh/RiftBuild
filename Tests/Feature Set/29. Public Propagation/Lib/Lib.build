Assembly PropLib
Type     static_lib

# Public keys are EXPORT-ONLY: they reach whoever depends on this library but
# are NOT applied to the library's own compilation...
Includes.Public .
Defines.Public  LIB_PUBLIC_DEFINE=1

# ...and a static library's Libraries.Public must reach the consumer's LINK:
# the app calls timeGetTime() from winmm, which is not linked by default, so
# dropping this line breaks the app's link (regression guard for the receipt
# export union of Libraries + Libraries.Public).
Libraries.Public:windows winmm

# ...while plain (private) defines apply here and stay inside this module.
Defines LIB_PRIVATE_DEFINE=1

SourceFiles lib
