# program_exists() as an if-condition: cmd always exists on Windows, and the
# fake tool never does. The source has #error traps for both directions.
Assembly    ProgramExists
SourceFiles main

if program_exists(cmd)
{
    Compiler.Defines HAVE_CMD=1
}

if program_exists(zz_no_such_tool_zz)
{
    Compiler.Defines HAVE_FAKE_TOOL=1
}
