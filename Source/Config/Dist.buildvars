# ===========================================
# Distribution build variables
# ===========================================

if cl goto msvc

WarningFlags         -Wall -Wextra -Wshadow -Wconversion -Wmissing-prototypes -Warray-bounds -Wunused -Wuninitialized
WarningFlagsDisabled -Wno-unused-parameter -Wno-gnu-zero-variadic-macro-arguments -Wno-variadic-macros -Wno-missing-field-initializers -Wno-missing-braces -Wno-typedef-redefinition
WarningErrorFlags    -Werror=vla -Werror=implicit-function-declaration -Werror=pointer-arith -Werror=shadow -Werror=uninitialized -Werror=array-bounds -Werror=implicit -Werror=incompatible-pointer-types -Werror=int-conversion -Werror=unused-function -Werror=return-type

if !gcc              WarningFlags         -Wpedantic
if !gcc              WarningFlagsDisabled -Wno-empty-translation-unit
if !gcc              WarningErrorFlags    -Werror=shorten-64-to-32 -Werror=compare-distinct-pointer-types

SecurityFlags        -fno-strict-overflow -fno-strict-aliasing

SharedCompilerFlags  -std=c99 -Os -fno-builtin-memcpy -fno-omit-frame-pointer -fno-exceptions -fno-math-errno -funroll-loops $SecurityFlags $WarningFlags $WarningFlagsDisabled $WarningErrorFlags
SharedLinkerFlags    
SharedDefines        NO_ASSERT NO_PROFILING _NO_CRT_STDIO_INLINE _FORTIFY_SOURCE=3 NDEBUG
SharedIncludeFlags   Source/Core Source/Libraries/Vendor

if x64               SharedCompilerFlags -msse2
if linux             SharedIncludeFlags  Source/Libraries/Linux
if linux             SharedLinkerFlags   -Wl,-z,nodlopen -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now
if linux             SecurityFlags       -fstack-clash-protection
if warn_leaks        SharedDefines       WARN_MEMLEAKS

_stop

msvc:

WarningFlags
WarningFlagsDisabled
WarningErrorFlags

SecurityFlags

SharedCompilerFlags  /O2 /TC
SharedLinkerFlags    
SharedDefines        NO_ASSERT NO_PROFILING _NO_CRT_STDIO_INLINE NDEBUG
SharedIncludeFlags   Source/Core Source/Libraries/Vendor
