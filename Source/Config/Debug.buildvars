# ===========================================
# Debug build variables
# ===========================================

if cl goto msvc

WarningFlags         -Wall -Wextra -Wshadow -Wconversion -Wmissing-prototypes -Warray-bounds -Wunused -Wuninitialized
WarningFlagsDisabled -Wno-unused-variable -Wno-unused-parameter -Wno-gnu-zero-variadic-macro-arguments -Wno-variadic-macros -Wno-missing-field-initializers -Wno-missing-braces
WarningErrorFlags    -Werror=vla -Werror=implicit-function-declaration -Werror=pointer-arith -Werror=shadow -Werror=uninitialized -Werror=array-bounds -Werror=implicit -Werror=incompatible-pointer-types -Werror=int-conversion
#-Werror=return-type

# newer flags (not supported in clang 3.4)
# -Wmisleading-indentation
# -Werror=alloca
# -Werror=float-conversion
# -Winfinite-recursion
# -fdeclspec -fdiagnostics-absolute-paths
# -gcodeview

if !gcc              WarningFlags         -Wpedantic
if !gcc              WarningFlagsDisabled -Wno-empty-translation-unit
if !gcc              WarningErrorFlags    -Werror=shorten-64-to-32 -Werror=compare-distinct-pointer-types

SecurityFlags        -fno-strict-overflow -fno-strict-aliasing

# newer security flags (not supported in clang 3.4)
# -fno-delete-null-pointer-checks 
# -fstack-protector-strong
# if x64 SecurityFlags -mshstk

SharedCompilerFlags  -std=c99 -O0 -g3 -MD -fno-builtin-memcpy -fno-omit-frame-pointer -fno-exceptions -fno-math-errno $SecurityFlags $WarningFlags $WarningFlagsDisabled $WarningErrorFlags
SharedLinkerFlags    -g3
SharedDefines        DEVELOPER NO_PROFILING _GLIBCXX_ASSERTIONS _GLIBCXX_DEBUG _GLIBCXX_DEBUG_PEDANTIC _NO_CRT_STDIO_INLINE
SharedIncludeFlags   Source/Core Source/Libraries/Vendor

if x64               SharedCompilerFlags -msse2
if linux             SharedLinkerFlags   -Wl,-z,nodlopen -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now
if linux             SharedIncludeFlags  Source/Libraries/Linux
if linux             SecurityFlags       -fstack-clash-protection
if warn_leaks        SharedDefines       WARN_MEMLEAKS

_stop

msvc:

WarningFlags
WarningFlagsDisabled
WarningErrorFlags

SecurityFlags

SharedCompilerFlags  /Od /TC
SharedLinkerFlags    
SharedDefines        DEVELOPER NO_PROFILING _GLIBCXX_ASSERTIONS _GLIBCXX_DEBUG _GLIBCXX_DEBUG_PEDANTIC _NO_CRT_STDIO_INLINE _DEBUG
SharedIncludeFlags   Source/Core Source/Libraries/Vendor
