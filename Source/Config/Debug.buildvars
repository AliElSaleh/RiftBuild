# ===========================================
# Debug build variables
# ===========================================

if cl goto msvc

WarningFlags         -Wall -Wextra -Wshadow -Wconversion -Winfinite-recursion -Wmissing-prototypes -Warray-bounds -Wmisleading-indentation -Wunused -Wuninitialized
WarningFlagsDisabled -Wno-unused-variable -Wno-gnu-zero-variadic-macro-arguments -Wno-unused-parameter
WarningErrorFlags    -Werror=vla -Werror=alloca -Werror=implicit-function-declaration -Werror=pointer-arith -Werror=shadow -Werror=uninitialized -Werror=array-bounds -Werror=implicit -Werror=incompatible-pointer-types -Werror=int-conversion -Werror=float-conversion -Werror=missing-field-initializers
#-Werror=return-type

if !gcc              WarningFlags -Wpedantic
if !gcc              WarningFlagsDisabled -Wno-empty-translation-unit
if !gcc              WarningErrorFlags -Werror=shorten-64-to-32

SecurityFlags        -fno-delete-null-pointer-checks -fno-strict-overflow -fno-strict-aliasing -fstack-protector-strong
if linux             SecurityFlags -fstack-clash-protection

SharedCompilerFlags  -std=c17 -O0 -g3 -MD -gcodeview -fno-exceptions -fno-math-errno $SecurityFlags $WarningFlags $WarningFlagsDisabled $WarningErrorFlags
SharedLinkerFlags    -g3
if linux             SharedLinkerFlags -Wl,-z,nodlopen -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now

if !gcc              SharedCompilerFlags -fdeclspec -fdiagnostics-absolute-paths

SharedDefines        DEVELOPER NO_PROFILING _GLIBCXX_ASSERTIONS _GLIBCXX_DEBUG _GLIBCXX_DEBUG_PEDANTIC _NO_CRT_STDIO_INLINE

# this requires compling with optimizations
#_FORTIFY_SOURCE=3 

SharedIncludeFlags   Source/Core Source/Libraries/Vendor

if linux             SharedIncludeFlags Source/Libraries/Linux

if _arch == x64      CompilerFlags -msse2
if _arch == x64      SecurityFlags -mshstk

if warn_leaks        SharedDefines WARN_MEMLEAKS


_stop

msvc:

WarningFlags
WarningFlagsDisabled
WarningErrorFlags

SecurityFlags

SharedCompilerFlags  /std:clatest
SharedLinkerFlags    
SharedDefines        DEVELOPER NO_PROFILING _GLIBCXX_ASSERTIONS _GLIBCXX_DEBUG _GLIBCXX_DEBUG_PEDANTIC _NO_CRT_STDIO_INLINE _DEBUG
SharedIncludeFlags   Source/Core Source/Libraries/Vendor
