SharedIncludeFlags               Source

SharedDefines                    NO_PROFILING _NO_CRT_STDIO_INLINE
if warn_leaks SharedDefines      WARN_MEMLEAKS
if debug      SharedDefines      _DEBUG DEVELOPER
if !debug     SharedDefines      NDEBUG NO_ASSERT
if asan       SharedDefines      RIFT_ASAN

if cl goto msvc

WarningFlags                     -Wall -Wextra -Wshadow -Wconversion -Wmissing-prototypes -Wunused -Wuninitialized -Werror
WarningFlagsDisabled             -Wno-typedef-redefinition -Wno-unused-parameter -Wno-unused-variable -Wno-gnu-zero-variadic-macro-arguments -Wno-incompatible-library-redeclaration
if !gcc WarningFlags             -Wpedantic
if mac  WarningFlagsDisabled     -Wno-nonportable-include-path

SharedCompilerFlags              -std=c99 -fno-builtin-memcpy -fno-omit-frame-pointer -fno-exceptions -fno-math-errno -fno-trapping-math -funroll-loops -fno-strict-overflow -fno-strict-aliasing $WarningFlags $WarningFlagsDisabled
SharedLinkerFlags                
if _sse2 SharedCompilerFlags     -msse2
if !gcc  SharedCompilerFlags     -mstack-probe-size=999999999
if gcc   SharedCompilerFlags     -mno-stack-arg-probe
if linux SharedCompilerFlags     -fstack-clash-protection
if linux SharedLinkerFlags       -Wl,-z,nodlopen -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now
if debug SharedCompilerFlags     -O0 -g3 -MD -ftrapv
if asan  SharedLinkerFlags       -fsanitize=address,undefined
if debug SharedLinkerFlags       -g3
if debug SharedDefines           _GLIBCXX_ASSERTIONS _GLIBCXX_DEBUG _GLIBCXX_DEBUG_PEDANTIC
if !debug SharedCompilerFlags    -Os -finline-functions
if !debug SharedDefines          _FORTIFY_SOURCE=3
if test  SharedCompilerFlags     --analyze -funsigned-char

if disassem  SharedCompilerFlags -S
if trace     SharedCompilerFlags -ftime-trace
if 32        SharedCompilerFlags -m32
if 32        SharedLinkerFlags   -m32

.stop

msvc:
SharedCompilerFlags              /Wall /W4 /WX /wd4100 /wd4164 /TC /GS- /Gs999999999 /EHs- /analyze /analyze:stacksize 8000000
SharedLinkerFlags                /SAFESEH:NO
if debug SharedCompilerFlags     /MTd /Od /Zi /RTC1 /FS /Fd"$(BuildDirectory)\$(Assembly).pdb"
if debug SharedLinkerFlags       /DEBUG
if !debug SharedCompilerFlags    /MT /O2
if 32 SharedCompilerFlags        /d2noftol3
