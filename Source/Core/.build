import ../Common.buildvars

Assembly              RiftCore
Type:shared           shared_lib
Type:!shared          static_lib

BuildDirectory        Build
IntermediateDirectory Intermediate

Compiler.Flags        $SharedCompilerFlags
Linker.Flags          $SharedLinkerFlags
Compiler.Defines      $SharedDefines
Compiler.Includes.Export ../

if windows
{
    Libraries.Export  kernel32 user32 shell32 ole32 advapi32 ntdll shlwapi bcrypt oleaut32
}

if bsd
{
    Libraries.Export  pthread
}

if !shared
{
    Compiler.Defines        RIFT_STATIC
    Compiler.Defines.Export RIFT_STATIC
}

SourceFiles          Log Memory StringUtils Platform_Core
SourceFiles          Platform_%(_platform)
SourceFiles:Unix|BSD Platform_Unix
SourceFiles:BSD      Platform_BSD

# -- Options ------------------------------

option.compiler(clang gcc cl) Select a compiler vendor to build with.
option.debug                  Build the debug version of this program.

# -- Help ---------------------------------

.Help
{
    To build a static library, just run: riftbuild
    To build a shared library, just run: riftbuild shared
    To view all build options, just run: riftbuild options

    There are two optimization modes:
      - Debug
      - Release
    
    You can specify which one you want like so:
      > riftbuild debug

    or specify nothing for a release build
      > riftbuild
}