#!/usr/bin/env riftbuild

.Help
{
   Below is a non-exhaustive list of possible ways to build this program:
    > riftbuild
    > riftbuild cl
    > riftbuild asan debug gcc
    > riftbuild hood
   
   -- Cool thing for Unix users ---------------
    If you have this build file's execute permission set and riftbuild is in your path,
    you can execute this file directly like a regular shell script:
     > ./RiftBuild.build
   --------------------------------------------
}

include Source/Common.buildvars

Compiler                 %%clang %%gcc %%cl
Assembly                 RiftBuild
Icon                     riftbuild

TitleName                Rift Build %^%debug
Description              A simpler build tool for C/C++, because fuck cmake
Version(macro)           0.1.0-beta-%_date.nosep
CompanyName              Artisan Softworks
Copyright(enforce)       Copyright (c) $CompanyName
License(generate)        BSD 3-Clause

SourceDirectory          Source
BuildDirectory:debug     Build/Debug%%32/%%Hood
BuildDirectory:!debug    Build/Dist%%32/%%Hood
IntermediateDirectory    Intermediate/$SourceDirectory

RiftCoreFiles            Core/Memory Core/StringUtils Core/Log Core/Platform_Core Core/Platform_%(_platform)
RiftCoreFiles:unix       Core/Platform_Unix
RiftCoreFiles:bsd        Core/Platform_BSD
SourceFiles              $RiftCoreFiles Program Backend Exporter Parse

Compiler.Flags           $SharedCompilerFlags
Linker.Flags             $SharedLinkerFlags
Includes                 $SharedIncludeFlags
Defines                  $SharedDefines %^%hood NO_PRINT_BUILD_CONFIG=%no_print_config
Libraries:linux          pthread
Libraries:bsd            pthread

if windows
{
    Linker.NoStdLib
    Linker.EntryPoint    EntryPoint
    Linker.Subsystem     Console

    Libraries            kernel32 user32 shell32 ole32 advapi32 ntdll shlwapi bcrypt oleaut32 microsoft_craziness%%32
    Libraries:32:!debug  libcmt  libvcruntime
    Libraries:32: debug  libcmtd libvcruntimed
    Libraries:asan       libucrt

    Library.Paths        Source/Libraries/Windows
}

# todo: make riftbuild handle this
if linux
{
    if @XDG_CURRENT_DESKTOP contains GNOME    Defines __gnome__
    if @XDG_CURRENT_DESKTOP contains KDE      Defines __kde__
    if @XDG_CURRENT_DESKTOP contains Cinnamon Defines __cinnamon__
}

if rad
{
    prebuild.exec  raddbg -ipc kill_all
    postbuild.exec raddbg -ipc run
}

option.clang.description           use clang compiler
option.gcc.description             use gcc compiler
option.cl.description              use cl compiler (windows only)
option.debug.description           build the debug version of this program
option.32.description              build for 32 bit mode
option.asan.description            enable address sanitizer for memory debugging purposes
option.hood.description            enable hood mode, the program will talk to you like a gangster!
option.no_print_config.description disable printing of the build configuration flags
option.asm.description             generate disassembly (.S) files
