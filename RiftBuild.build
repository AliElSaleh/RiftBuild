if debug Mode Debug else Mode Dist
include Source/$(Mode).buildvars

Assembly RiftBuild
Icon     riftbuild.ico

TitleName               Rift Build ($(Mode))
Description             A simpler build tool for C/C++, because fuck cmake
Version                 0.9.6
CompanyName             Ali El Saleh
Copyright!              Copyright (c) 2024 Ali El Saleh

SourceDirectory         Source
BuildDirectory          Build/$(Mode)/%%Hood

CompilerFlags           $SharedCompilerFlags -mno-stack-arg-probe -mstack-probe-size=999999999
LinkerFlags             $SharedLinkerFlags
Includes                $SharedIncludeFlags
Defines                 $SharedDefines HEADLESS RIFT_STATIC NO_LOG_FILE %^%hood
Libraries               %_NativeLibs

IncludedSourceFiles     Clock.c Math.c Memory.c Allocators.c StringUtils.c Containers.c Globals.c Log.c EngineUtils.c Program.c CBackend.c MSVCBackend.c Exporter.c Parse.c

if _platform == windows IncludedSourceFiles Platform_Windows.c
if _platform == linux   IncludedSourceFiles Platform_Linux.c
if _platform == macos   IncludedSourceFiles Platform_Mac.c
if _platform == bsd     IncludedSourceFiles Platform_BSD.c

if _platform == windows LinkerFlags -nostdlib -Wl,-entry:ProgramStart,-subsystem:console -Xlinker /stack:0x400000,0x400000

if _platform == linux   Libraries UUIDS ; LibraryDirectories Libraries/Linux