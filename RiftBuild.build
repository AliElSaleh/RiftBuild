include Source/Common-Ideal.buildvars

Compiler                 %%clang %%gcc %%cl
Assembly                 RiftBuild
Icon                     riftbuild

TitleName                Rift Build %^%debug
Description              A simpler build tool for C/C++, because fuck cmake
Version(macro)           0.9.9-alpha-%_date.nosep
CompanyName              Artisan Softworks
Copyright(enforce)       Copyright (c) $CompanyName
License                  BSD 3-Clause

SourceDirectory          Source
BuildDirectory:debug     Build/Debug%%32/%%Hood
BuildDirectory:!debug    Build/Dist%%32/%%Hood

CompilerFlags            $SharedCompilerFlags
LinkerFlags              $SharedLinkerFlags
Includes                 $SharedIncludeFlags
Defines                  $SharedDefines %^%hood

IncludedSourceFiles      Memory.c StringUtils.c Globals.c Log.c Platform_Core.c Program.c Backend.c Exporter.c Parse.c Platform_%(_platform).c
IncludedSourceFiles:unix Platform_Unix.c

Libraries:linux          pthread uuidS
Libraries:bsd            pthread
LibraryDirectories       Source/Libraries/%_platform

if windows
{
    #todo: remove
    if !cl if !gcc       LinkerFlags -nostdlib -Wl,-entry:EntryPoint,-subsystem:console -Xlinker /stack:0x800000,0x800000
    if gcc               LinkerFlags -nostdlib -Wl,--entry,EntryPoint,--subsystem,console,--stack,0x800000
    if cl                LinkerFlags /ENTRY:EntryPoint /SUBSYSTEM:CONSOLE /STACK:0x800000,0x800000
    
    if 32 if !debug      Libraries libcmt libvcruntime
    if 32 if debug       Libraries libcmtd libvcruntimed
    if asan              Libraries libucrt
                         Libraries %_NativeLibs microsoft_craziness%%32

    # todo: make riftbuild do this
    if debug             PreLink.Delete $BuildDirectory/$(Assembly).pdb
}

if linux
{
    if @XDG_CURRENT_DESKTOP contains GNOME    Defines __gnome__
    if @XDG_CURRENT_DESKTOP contains KDE      Defines __kde__
    if @XDG_CURRENT_DESKTOP contains Cinnamon Defines __cinnamon__
}

if rad
{
    prebuild.exec  raddbg -ipc kill_all
    postbuild.exec raddbg -ipc run
}
