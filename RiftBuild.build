if debug Mode Debug else Mode Dist
include Source/Config/$(Mode).buildvars

Compiler                %%cl %%gcc %%clang

Assembly                RiftBuild
Icon                    riftbuild

TitleName               Rift Build %^%debug
Description             A simpler build tool for C/C++, because fuck cmake
Version!                0.9.7-alpha
CompanyName             Ali El Saleh
Copyright!              Copyright (c) 2024 Ali El Saleh

SourceDirectory         Source
BuildDirectory          Build/$(Mode)/%%Hood

CompilerFlags           $SharedCompilerFlags
LinkerFlags             $SharedLinkerFlags
Includes                $SharedIncludeFlags
Defines                 $SharedDefines RIFT_STATIC %^%hood

IncludedSourceFiles     Clock.c Memory.c StringUtils.c Globals.c Log.c Program.c Backend.c Exporter.c Parse.c

if cl                   IncludedSourceFiles memcmp.asm memset.asm

if windows              IncludedSourceFiles Platform_Windows.c
if linux                IncludedSourceFiles Platform_Linux.c
if mac                  IncludedSourceFiles Platform_Mac.c
if bsd                  IncludedSourceFiles Platform_BSD.c

if mac                  CompilerFlags -mmacosx-version-min=10.5

if !cl if !gcc          CompilerFlags -mstack-probe-size=999999999
if gcc                  CompilerFlags -mno-stack-arg-probe
if cl                   CompilerFlags /GS- /Gs999999999

if !cl if disassemble   CompilerFlags -S

if windows {
    if !cl              CompilerFlags -nostdlib -fno-builtin -ffreestanding
    if !cl if !gcc      LinkerFlags   -nostdlib -Wl,-entry:ProgramStart,-subsystem:console -Xlinker /stack:0x400000,0x400000
    if gcc              LinkerFlags   -nostdlib -Wl,--entry,ProgramStart,--subsystem,console,--stack,0x400000
    if cl               LinkerFlags   /ENTRY:ProgramStart /SUBSYSTEM:CONSOLE /STACK:0x400000,0x400000
}

if windows              Libraries %_NativeLibs
if linux                Libraries uuidS pthread ; LibraryDirectories Source/Libraries/Linux

if linux {
    if @XDG_CURRENT_DESKTOP contains GNOME    Defines __gnome__
    if @XDG_CURRENT_DESKTOP contains KDE      Defines __kde__
    if @XDG_CURRENT_DESKTOP contains Cinnamon Defines __cinnamon__
}
