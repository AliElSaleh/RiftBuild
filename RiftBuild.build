if debug Mode Debug else Mode Dist
include Source/$(Mode).buildvars

if cl                   Compiler cl

Assembly                RiftBuild
#Icon                    /usr/share/icons/hicolor/32x32/apps/firefox.png
Icon                    riftbuild

TitleName               Rift Build %^%debug
Description             A simpler build tool for C/C++, because fuck cmake
Version!                0.9.6-alpha
CompanyName             Ali El Saleh
Copyright!              Copyright (c) 2024 Ali El Saleh

SourceDirectory         Source
BuildDirectory          Build/$(Mode)/%%Hood

CompilerFlags           $SharedCompilerFlags
LinkerFlags             $SharedLinkerFlags
Includes                $SharedIncludeFlags
Defines                 $SharedDefines RIFT_STATIC NO_LOG_FILE %^%hood
Libraries               %_NativeLibs

IncludedSourceFiles     Clock.c Math.c Memory.c Allocators.c StringUtils.c Containers.c Globals.c Log.c EngineUtils.c Program.c CBackend.c MSVCBackend.c Exporter.c Parse.c

if cl                   IncludedSourceFiles memcmp.asm memset.asm

if windows              IncludedSourceFiles Platform_Windows.c
if linux                IncludedSourceFiles Platform_Linux.c
if macos                IncludedSourceFiles Platform_Mac.c
if bsd                  IncludedSourceFiles Platform_BSD.c

if apple                CompilerFlags -mmacosx-version-min=10.5

if !cl                  CompilerFlags -mno-stack-arg-probe -mstack-probe-size=999999999
if cl                   CompilerFlags /GS- /Gs999999999

if !cl if windows       LinkerFlags -nostdlib -Wl,-entry:ProgramStart,-subsystem:console -Xlinker /stack:0x400000,0x400000
if cl  if windows       LinkerFlags /ENTRY:ProgramStart /SUBSYSTEM:CONSOLE /STACK:0x400000,0x400000

if linux                Libraries UUIDS ; LibraryDirectories Source/Libraries/Linux

# this is ugly. the env var could get deleted by accident... but it _seems_ to be the most reliable
if linux {
    if @XDG_CURRENT_DESKTOP contains GNOME Defines __gnome__
    if @XDG_CURRENT_DESKTOP contains KDE   Defines __kde__
    #if find(gnome-shell) Defines __gnome__
}


##
icon_png Source/Resources/riftbuild.png
# app bundle creation
if apple {
    #PostBuild.Log
    #PostBuild.Delete       Build/$(Assembly).app/
    PostBuild.NewDirectory Build/$(Assembly).app/Contents/MacOS
    PostBuild.NewDirectory Build/$(Assembly).app/Contents/Resources
    PostBuild.NewDirectory Build/$(Assembly).app/Contents/Frameworks

    #PostBuild.Delete       Build/$(Assembly).iconset
    PostBuild.NewDirectory Build/$(Assembly).iconset

    PostBuild.Cmd          sips -z 16 16 $icon_png --out Build/$(Assembly).iconset/icon_16x16.png
    PostBuild.Cmd          sips -z 32 32 $icon_png --out Build/$(Assembly).iconset/icon_32x32.png
    PostBuild.Cmd          sips -z 64 64 $icon_png --out Build/$(Assembly).iconset/icon_64x64.png
    PostBuild.Cmd          sips -z 128 128 $icon_png --out Build/$(Assembly).iconset/icon_128x128.png
    PostBuild.Cmd          sips -z 256 256 $icon_png --out Build/$(Assembly).iconset/icon_256x256.png
    PostBuild.Cmd          sips -z 512 512 $icon_png --out Build/$(Assembly).iconset/icon_512x512.png
    PostBuild.Cmd          iconutil -c icns -o Build/$(Assembly).icns Build/$(Assembly).iconset

    PostBuild.Cmd          cp Build/Info.plist              Build/$(Assembly).app/Contents
    PostBuild.Cmd          cp Build/PkgInfo                 Build/$(Assembly).app/Contents
    PostBuild.Cmd          cp Build/$(Assembly).icns        Build/$(Assembly).app/Contents/Resources
    PostBuild.Cmd          printf "#!/bin/sh\nopen -a Terminal %(_WorkingDirectory)/Build/riftbuild.app/Contents/MacOS/riftbuild-bin --args /Users/ali/Source" > Build/riftbuild.app/Contents/MacOS/riftbuild
    PostBuild.Cmd          chmod 755 Build/riftbuild.app/Contents/MacOS/riftbuild
    PostBuild.Cmd          cp $(BuildDirectory)/$(Assembly) Build/$(Assembly).app/Contents/MacOS/$(Assembly)-bin
}
